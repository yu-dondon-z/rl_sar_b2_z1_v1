    <inertial>
      <origin xyz="0.0241569 -0.0001735 -0.0014388" rpy="0 0 0" />
      <mass value="0.2887581" />
      <inertia ixx="0.0001833" ixy="0.0000012" ixz="0.0000005" iyy="0.0001475" iyz="0.0000001" izz="0.0001468" />
    </inertial>
  </link>

  <!-- Fixed target frames retained for compatibility with the source model. -->
  <joint name="joint_mounter" type="fixed">
    <parent link="link06" />
    <child link="link_mounter" />
    <origin xyz="0.075 0 0" rpy="0 0 0" />
