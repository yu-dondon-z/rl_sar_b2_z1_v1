  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <!-- MuJoCo needs a finer contact integration step than the 5 ms control
       loop for this high-gain, heavy quadruped.  Control remains at 200 Hz
       and policy inference at 50 Hz; MuJoCo performs five physics substeps. -->
  <option timestep="0.001" cone="elliptic" impratio="100"/>

