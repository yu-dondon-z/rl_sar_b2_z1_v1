{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建 B2-Z1 MuJoCo 部署",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/cmake_build",
                "--target",
                "rl_sim_mujoco",
                "-j2"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
