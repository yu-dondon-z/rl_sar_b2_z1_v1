{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "部署：MuJoCo B2+Z1 无枪（调试）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cmake_build/bin/rl_sim_mujoco",
            "args": [
                "b2_z1_no_gun",
                "scene_flat"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "启用 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "构建 B2-Z1 MuJoCo 部署"
        }
    ]
}
