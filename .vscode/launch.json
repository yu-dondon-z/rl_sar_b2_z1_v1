{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "部署 v4：MuJoCo 视觉+焊枪（model_10300）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_b2_z1_v4.py",
            "python": "/home/dong/anaconda3/envs/crack_vision/bin/python",
            "args": ["--mode", "vision", "--display-vision"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "部署：MuJoCo B2+Z1 轨迹跟随（调试）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cmake_build/bin/rl_sim_mujoco",
            "args": [
                "b2_z1_no_gun",
                "scene_flat"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "启用 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "构建 B2-Z1 MuJoCo 部署"
        },
