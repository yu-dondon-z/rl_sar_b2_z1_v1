<mujoco model="b2 z1 visual crack trajectory scene">
  <include file="b2.xml"/>

  <statistic center="0 0 0.35" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <!-- The same high-resolution greyscale map drives appearance and the
         collision height field: road=top, black centreline=5 cm groove. -->
    <hfield name="cracked_ground" file="vision_cracked_ground.png"
            size="22.5 2.0 0.05 0.10"/>
    <texture type="2d" name="cracked_ground_texture"
             file="vision_cracked_ground.png"/>
    <material name="groundplane" texture="cracked_ground_texture"
              texuniform="false" reflectance="0.05" roughness="0.9"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <!-- Continuous road covering x=-5..40 m and y=-2..2 m. The 2 cm-wide
         centre groove is a real 5 cm depression in both RGB-D and collision. -->
    <geom name="floor" pos="17.5 0 -0.05" type="hfield"
          hfield="cracked_ground" material="groundplane"
          friction="1.0 0.005 0.0001"/>
    <!-- Non-colliding trajectory visualization. Cyan points show the loaded
         path, the green point is the current policy EE target, and the red
         point in b2.xml shows the actual policy-tracked dummy_target TCP. -->
    <body name="trajectory_target_visual" mocap="true" pos="0 0 -10">
      <geom type="sphere" size="0.035" rgba="0.1 1 0.2 0.9"
            contype="0" conaffinity="0" group="2"/>
    </body>
    <body name="trajectory_path_visual_00" mocap="true" pos="0 0 -10"><geom type="sphere" size="0.014" rgba="0.1 0.9 1 0.85" contype="0" conaffinity="0" group="2"/></body>
    <body name="trajectory_path_visual_01" mocap="true" pos="0 0 -10"><geom type="sphere" size="0.014" rgba="0.1 0.9 1 0.85" contype="0" conaffinity="0" group="2"/></body>
